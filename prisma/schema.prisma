// Prisma Schema for Enterprise Multi-Tenant NGO Management & Digital Platform
// Designed for PostgreSQL with multi-tenancy, RBAC, 80G tax compliance, and comprehensive audit trails

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 1. ENUMS
// ==========================================

enum OrgTier {
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DEACTIVATED
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum DonationStatus {
  PENDING
  SUCCESSFUL
  FAILED
  REFUNDED
}

enum PaymentMethod {
  UPI
  CARD
  NETBANKING
  BANK_TRANSFER
  CHEQUE
  CASH
}

enum VolunteerStatus {
  APPLIED
  INTERVIEWING
  ACTIVE
  ON_LEAVE
  INACTIVE
}

enum MemberStatus {
  ACTIVE
  GRACE_PERIOD
  EXPIRED
  SUSPENDED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  COMPLETED
  BLOCKED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  ON_LEAVE
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum EventStatus {
  UPCOMING
  ONGOING
  COMPLETED
  CANCELLED
}

enum CertificateType {
  VOLUNTEER_SERVICE
  DONOR_80G
  MEMBERSHIP
  TRAINING_COMPLETION
  EVENT_PARTICIPATION
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  EXPORT
  SETTINGS_CHANGE
}

// ==========================================
// 2. MULTI-TENANT ROOT: ORGANIZATION
// ==========================================

model Organization {
  id                String       @id @default(uuid())
  name              String
  legalName         String?
  slug              String       @unique
  tier              OrgTier      @default(PROFESSIONAL)
  logoUrl           String?
  websiteUrl        String?
  supportEmail      String
  contactPhone      String?
  address           String?
  city              String?
  state             String?
  postalCode        String?
  country           String       @default("India")
  
  // Statutory NGO Compliance
  panNumber         String?
  darpanId          String?
  fcraNumber        String?
  section80GRegNo   String?
  section12ARegNo   String?
  taxExemptionRate  Int          @default(50) // 50% under 80G
  
  // Customization
  primaryColor      String       @default("#059669")
  currency          String       @default("INR")
  locale            String       @default("en-IN")
  timezone          String       @default("Asia/Kolkata")
  
  // Timestamps
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  // Tenant-scoped relations
  users             User[]
  roles             Role[]
  departments       Department[]
  teams             Team[]
  teamMembers       TeamMember[]
  volunteers        Volunteer[]
  donors            Donor[]
  members           Member[]
  projects          Project[]
  programs          Program[]
  campaigns         Campaign[]
  donations         Donation[]
  transactions      Transaction[]
  events            Event[]
  tasks             Task[]
  attendances       Attendance[]
  leaveRequests     LeaveRequest[]
  certificates      Certificate[]
  documents         Document[]
  blogs             Blog[]
  news              News[]
  media             Media[]
  galleries         Gallery[]
  notifications     Notification[]
  messages          Message[]
  contactRequests   ContactRequest[]
  reports           Report[]
  auditLogs         AuditLog[]
  settings          Setting[]
  subscribers       NewsletterSubscriber[]

  @@index([slug])
  @@index([createdAt])
}

// ==========================================
// 3. IDENTITY, USERS & RBAC
// ==========================================

model User {
  id                String            @id @default(uuid())
  organizationId    String
  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  email             String
  passwordHash      String?
  fullName          String
  avatarUrl         String?
  phoneNumber       String?
  status            UserStatus        @default(ACTIVE)
  twoFactorEnabled  Boolean           @default(false)
  lastLoginAt       DateTime?
  
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  // Relations
  userRoles         UserRole[]
  teamMember        TeamMember?
  volunteer         Volunteer?
  donor             Donor?
  member            Member?
  createdTasks      Task[]            @relation("TaskCreator")
  assignedTasks     Task[]            @relation("TaskAssignee")
  leaveRequests     LeaveRequest[]
  attendances       Attendance[]
  auditLogs         AuditLog[]
  notifications     Notification[]
  sentMessages      Message[]         @relation("MessageSender")
  receivedMessages  Message[]         @relation("MessageReceiver")

  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([email])
  @@index([status])
}

model Role {
  id              String            @id @default(uuid())
  organizationId  String
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  name            String
  code            String            // e.g., SUPER_ADMIN, OPS_ADMIN, PROGRAM_LEAD, VOLUNTEER, DONOR
  description     String?
  isSystemRole    Boolean           @default(false)
  
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

model Permission {
  id              String            @id @default(uuid())
  code            String            @unique // e.g. DONATIONS_READ, VOLUNTEERS_MANAGE, 80G_GENERATE
  module          String            // e.g. DONATIONS, VOLUNTEERS, FINANCE, CMS
  description     String
  
  createdAt       DateTime          @default(now())

  rolePermissions RolePermission[]

  @@index([module])
}

model UserRole {
  id          String       @id @default(uuid())
  userId      String
  roleId      String
  assignedAt  DateTime     @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model RolePermission {
  id            String       @id @default(uuid())
  roleId        String
  permissionId  String

  role          Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission    Permission   @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

// ==========================================
// 4. ORGANIZATION STRUCTURE & TEAM
// ==========================================

model Department {
  id              String         @id @default(uuid())
  organizationId  String
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  name            String
  code            String
  description     String?
  
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  teams           Team[]
  teamMembers     TeamMember[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

model Team {
  id              String         @id @default(uuid())
  organizationId  String
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departmentId    String
  department      Department     @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  
  name            String
  leadUserId      String?
  
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  members         TeamMember[]

  @@index([organizationId])
  @@index([departmentId])
}

model TeamMember {
  id              String         @id @default(uuid())
  organizationId  String
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId          String         @unique
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  departmentId    String?
  department      Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  teamId          String?
  team            Team?          @relation(fields: [teamId], references: [id], onDelete: SetNull)
  
  designation     String
  employmentType  String         @default("FULL_TIME") // FULL_TIME, PART_TIME, CONTRACT
  joiningDate     DateTime
  
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([organizationId])
  @@index([departmentId])
  @@index([teamId])
}

// ==========================================
// 5. VOLUNTEERS
// ==========================================

model Volunteer {
  id                String                @id @default(uuid())
  organizationId    String
  organization      Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId            String                @unique
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  badgeLevel        String                @default("BRONZE") // BRONZE, SILVER, GOLD, PLATINUM
  totalHoursLogged  Float                 @default(0.0)
  status            VolunteerStatus       @default(APPLIED)
  emergencyContact  String?
  preferredCauses   String[]              @default([])
  skills            String[]              @default([])
  city              String?
  
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  attendances       VolunteerAttendance[]

  @@index([organizationId])
  @@index([status])
  @@index([badgeLevel])
}

model VolunteerAttendance {
  id            String       @id @default(uuid())
  volunteerId   String
  volunteer     Volunteer    @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  eventId       String?
  event         Event?       @relation(fields: [eventId], references: [id], onDelete: SetNull)
  
  date          DateTime
  hoursServed   Float
  verifiedBy    String?
  verifiedAt    DateTime?
  notes         String?
  
  createdAt     DateTime     @default(now())

  @@index([volunteerId])
  @@index([eventId])
  @@index([date])
}

// ==========================================
// 6. DONORS & 80G STATUTORY DONATIONS
// ==========================================

model Donor {
  id                String         @id @default(uuid())
  organizationId    String
  organization      Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId            String?        @unique
  user              User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  donorType         String         @default("INDIVIDUAL") // INDIVIDUAL, CORPORATE_CSR, TRUST_FOUNDATION
  panNumber         String?
  companyName       String?
  gstin             String?
  addressLine       String?
  city              String?
  state             String?
  postalCode        String?
  country           String         @default("India")
  
  lifetimeGiving    Float          @default(0.0)
  totalDonations    Int            @default(0)
  isAnonymous       Boolean        @default(false)
  is80GEligible     Boolean        @default(true)
  
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  donations         Donation[]
  certificates      Certificate[]

  @@index([organizationId])
  @@index([donorType])
  @@index([panNumber])
}

model Donation {
  id                String            @id @default(uuid())
  organizationId    String
  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  donorId           String
  donor             Donor             @relation(fields: [donorId], references: [id], onDelete: Cascade)
  campaignId        String?
  campaign          Campaign?         @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  projectId         String?
  project           Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  
  amount            Float
  currency          String            @default("INR")
  status            DonationStatus    @default(SUCCESSFUL)
  paymentMethod     PaymentMethod     @default(UPI)
  
  // 80G Statutory compliance
  form10BEReceiptNo String?           @unique
  taxExemptionValue Float?
  is80GIssued       Boolean           @default(false)
  
  notes             String?
  donatedAt         DateTime          @default(now())
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  transactions      Transaction[]

  @@index([organizationId])
  @@index([donorId])
  @@index([campaignId])
  @@index([status])
  @@index([donatedAt])
}

model Transaction {
  id                String         @id @default(uuid())
  organizationId    String
  organization      Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  donationId        String?
  donation          Donation?      @relation(fields: [donationId], references: [id], onDelete: SetNull)
  
  gatewayName       String         // e.g. RAZORPAY, STRIPE, CASHFREE
  gatewayPaymentId  String?
  gatewayOrderId    String?
  amount            Float
  currency          String         @default("INR")
  feeAmount         Float          @default(0.0)
  taxAmount         Float          @default(0.0)
  status            String         // SUCCESS, FAILED, PROCESSING
  rawResponseJson   String?
  
  createdAt         DateTime       @default(now())

  @@index([organizationId])
  @@index([donationId])
  @@index([gatewayPaymentId])
}

// ==========================================
// 7. MEMBERSHIP & DIGITAL PASSES
// ==========================================

model Member {
  id                String         @id @default(uuid())
  organizationId    String
  organization      Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId            String         @unique
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  membershipTier    String         @default("STANDARD") // STANDARD, FELLOW, LIFETIME, PATRON
  membershipNumber  String         @unique
  status            MemberStatus   @default(ACTIVE)
  validFrom         DateTime       @default(now())
  validUntil        DateTime
  qrPassCode        String         @unique
  
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([organizationId])
  @@index([status])
  @@index([membershipNumber])
}

// ==========================================
// 8. PROJECTS, PROGRAMS & CAMPAIGNS
// ==========================================

model Program {
  id              String         @id @default(uuid())
  organizationId  String
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  name            String
  code            String
  description     String
  sdgGoal         Int?           // UN Sustainable Development Goal (1-17)
  
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  projects        Project[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

model Project {
  id              String         @id @default(uuid())
  organizationId  String
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  programId       String?
  program         Program?       @relation(fields: [programId], references: [id], onDelete: SetNull)
  
  name            String
  slug            String
  description     String
  status          ProjectStatus  @default(ACTIVE)
  budgetAmount    Float          @default(0.0)
  spentAmount     Float          @default(0.0)
  targetBeneficiaries Int        @default(0)
  actualBeneficiaries Int        @default(0)
  location        String
  startDate       DateTime
  endDate         DateTime?
  
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  campaigns       Campaign[]
  donations       Donation[]
  tasks           Task[]
  events          Event[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([status])
  @@index([programId])
}

model Campaign {
  id              String         @id @default(uuid())
  organizationId  String
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId       String?
  project         Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  
  title           String
  slug            String
  story           String
  goalAmount      Float
  raisedAmount    Float          @default(0.0)
  coverImageUrl   String?
  status          CampaignStatus @default(ACTIVE)
  startDate       DateTime       @default(now())
  endDate         DateTime?
  is80GEligible   Boolean        @default(true)
  
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  donations       Donation[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([status])
  @@index([projectId])
}

// ==========================================
// 9. EVENTS & COMMUNITY
// ==========================================

model Event {
  id              String         @id @default(uuid())
  organizationId  String
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId       String?
  project         Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  
  title           String
  slug            String
  description     String
  location        String
  isVirtual       Boolean        @default(false)
  virtualLink     String?
  startTime       DateTime
  endTime         DateTime
  maxAttendees    Int?
  status          EventStatus    @default(UPCOMING)
  
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  registrations   EventRegistration[]
  volunteerHours  VolunteerAttendance[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([status])
  @@index([startTime])
}

model EventRegistration {
  id          String       @id @default(uuid())
  eventId     String
  event       Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  
  attendeeName  String
  attendeeEmail String
  attendeePhone String?
  isAttended    Boolean    @default(false)
  
  registeredAt  DateTime   @default(now())

  @@unique([eventId, attendeeEmail])
  @@index([eventId])
}

// ==========================================
// 10. TASKS, ATTENDANCE & LEAVES
// ==========================================

model Task {
  id              String         @id @default(uuid())
  organizationId  String
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId       String?
  project         Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  
  title           String
  description     String?
  status          TaskStatus     @default(TODO)
  priority        TaskPriority   @default(MEDIUM)
  dueDate         DateTime?
  
  creatorId       String
  creator         User           @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  assigneeId      String?
  assignee        User?          @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([organizationId])
  @@index([status])
  @@index([assigneeId])
  @@index([projectId])
}

model Attendance {
  id              String           @id @default(uuid())
  organizationId  String
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  date            DateTime
  checkIn         DateTime?
  checkOut        DateTime?
  status          AttendanceStatus @default(PRESENT)
  workSummary     String?
  
  createdAt       DateTime         @default(now())

  @@unique([userId, date])
  @@index([organizationId])
  @@index([userId])
  @@index([date])
}

model LeaveRequest {
  id              String         @id @default(uuid())
  organizationId  String
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  leaveType       String         // CASUAL, SICK, PAID, EMERGENCY
  startDate       DateTime
  endDate         DateTime
  reason          String
  status          LeaveStatus    @default(PENDING)
  reviewedBy      String?
  reviewedAt      DateTime?
  
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([organizationId])
  @@index([userId])
  @@index([status])
}

// ==========================================
// 11. CERTIFICATES & DOCUMENTS
// ==========================================

model Certificate {
  id                String          @id @default(uuid())
  organizationId    String
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  donorId           String?
  donor             Donor?          @relation(fields: [donorId], references: [id], onDelete: SetNull)
  
  certificateNumber String          @unique
  type              CertificateType @default(DONOR_80G)
  recipientName     String
  recipientEmail    String
  title             String
  description       String?
  issuedDate        DateTime        @default(now())
  qrVerificationUrl String
  
  createdAt         DateTime        @default(now())

  @@index([organizationId])
  @@index([certificateNumber])
  @@index([type])
}

model Document {
  id              String         @id @default(uuid())
  organizationId  String
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  title           String
  category        String         // AUDIT_REPORT, FCRA_RETURN, POLICY, CSR_DECK
  fileUrl         String
  fileSize        Int
  mimeType        String
  isPublic        Boolean        @default(false)
  
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([organizationId])
  @@index([category])
  @@index([isPublic])
}

// ==========================================
// 12. CMS: BLOG, NEWS, MEDIA & GALLERY
// ==========================================

model Blog {
  id              String         @id @default(uuid())
  organizationId  String
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  title           String
  slug            String
  excerpt         String
  contentMarkdown String
  coverImageUrl   String?
  authorName      String
  category        String
  isPublished     Boolean        @default(false)
  publishedAt     DateTime?
  
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([isPublished])
}

model News {
  id              String         @id @default(uuid())
  organizationId  String
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  headline        String
  sourceName      String?
  externalUrl     String?
  publishedDate   DateTime
  
  createdAt       DateTime       @default(now())

  @@index([organizationId])
  @@index([publishedDate])
}

model Media {
  id              String         @id @default(uuid())
  organizationId  String
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  fileName        String
  fileUrl         String
  fileType        String
  fileSize        Int
  altText         String?
  
  createdAt       DateTime       @default(now())

  @@index([organizationId])
}

model Gallery {
  id              String         @id @default(uuid())
  organizationId  String
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  title           String
  description     String?
  coverImageUrl   String
  imageUrls       String[]       @default([])
  
  createdAt       DateTime       @default(now())

  @@index([organizationId])
}

// ==========================================
// 13. NOTIFICATIONS, MESSAGES & CONTACT
// ==========================================

model Notification {
  id              String         @id @default(uuid())
  organizationId  String
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  title           String
  message         String
  type            String         // SYSTEM, DONATION, VOLUNTEER, TASK
  isRead          Boolean        @default(false)
  actionUrl       String?
  
  createdAt       DateTime       @default(now())

  @@index([organizationId])
  @@index([userId])
  @@index([isRead])
}

model Message {
  id              String         @id @default(uuid())
  organizationId  String
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  senderId        String
  sender          User           @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId      String
  receiver        User           @relation("MessageReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  
  subject         String?
  body            String
  isRead          Boolean        @default(false)
  
  createdAt       DateTime       @default(now())

  @@index([organizationId])
  @@index([senderId])
  @@index([receiverId])
}

model ContactRequest {
  id              String         @id @default(uuid())
  organizationId  String
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  name            String
  email           String
  phone           String?
  subject         String
  message         String
  isResolved      Boolean        @default(false)
  
  createdAt       DateTime       @default(now())

  @@index([organizationId])
  @@index([isResolved])
}

// ==========================================
// 14. REPORTING, AUDIT LOG & SYSTEM SETTINGS
// ==========================================

model Report {
  id              String         @id @default(uuid())
  organizationId  String
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  title           String
  reportType      String         // DONATION_SUMMARY, 80G_LEDGER, VOLUNTEER_HOURS, PROJECT_IMPACT
  parametersJson  String?
  fileUrl         String?
  generatedBy     String
  
  createdAt       DateTime       @default(now())

  @@index([organizationId])
  @@index([reportType])
}

model AuditLog {
  id              String         @id @default(uuid())
  organizationId  String
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId          String?
  user            User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  action          AuditAction
  entityType      String         // DONATION, USER, ROLE, CAMPAIGN, SETTING
  entityId        String?
  metadataJson    String?
  ipAddress       String?
  userAgent       String?
  
  createdAt       DateTime       @default(now())

  @@index([organizationId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
}

model Setting {
  id              String         @id @default(uuid())
  organizationId  String
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  key             String
  valueJson       String
  
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([organizationId, key])
  @@index([organizationId])
}

model NewsletterSubscriber {
  id              String         @id @default(uuid())
  organizationId  String
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  email           String
  isActive        Boolean        @default(true)
  
  createdAt       DateTime       @default(now())

  @@unique([organizationId, email])
  @@index([organizationId])
}
