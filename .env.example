# ==========================================
# ENTERPRISE NGO DIGITAL PLATFORM CONFIGURATION
# ==========================================

# APP_URL: Current hosting origin
APP_URL="http://localhost:3000"
NODE_ENV="development"
LOG_LEVEL="debug"

# ------------------------------------------
# DATABASE (MongoDB + Mongoose)
# ------------------------------------------
MONGODB_URI="mongodb://localhost:27017/ngo_platform"

# ------------------------------------------
# AUTHENTICATION (Phase 3 Preparation)
# ------------------------------------------
JWT_SECRET="replace-with-a-secure-random-256-bit-secret"
SESSION_MAX_AGE="604800"

# ------------------------------------------
# OBJECT STORAGE (Media, Certificates, 80G Form 10BE)
# ------------------------------------------
STORAGE_PROVIDER="local" # local | s3 | gcs
S3_BUCKET="ngo-vault"
S3_REGION="ap-south-1"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

# ------------------------------------------
# EMAIL & NOTIFICATIONS
# ------------------------------------------
EMAIL_PROVIDER="smtp" # smtp | resend | sendgrid
EMAIL_FROM="noreply@ngo-platform.org"
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

# ------------------------------------------
# PAYMENT GATEWAYS (80G Donations)
# ------------------------------------------
PAYMENT_GATEWAY_DEFAULT="razorpay"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""

# ------------------------------------------
# ANALYTICS & TELEMETRY
# ------------------------------------------
ANALYTICS_ENABLED="false"
