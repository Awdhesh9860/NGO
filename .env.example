# ==========================================
# ENTERPRISE NGO DIGITAL PLATFORM CONFIGURATION
# ==========================================

# APP_URL: Current hosting origin
APP_URL="http://localhost:3000"
NODE_ENV="development"
LOG_LEVEL="debug"

# Set to "true" ONLY in local non-production sandboxes to enable the 13-role UI persona switcher
NEXT_PUBLIC_ENABLE_DEMO_PERSONAS="false"

# ------------------------------------------
# DATABASE (MongoDB + Mongoose)
# ------------------------------------------
MONGODB_URI="mongodb://localhost:27017/ngo_platform"

# ------------------------------------------
# AUTHENTICATION & CRYPTOGRAPHY (MANDATORY >= 32 chars in production)
# ------------------------------------------
JWT_SECRET="replace-with-a-secure-random-256-bit-secret-min-32-chars"
SESSION_MAX_AGE="604800"
FINANCIAL_ENCRYPTION_KEY="replace-with-a-distinct-32-char-financial-aes-256-key"

# ------------------------------------------
# OBJECT STORAGE (Private Document Vault, Receipts, Compliance Files)
# ------------------------------------------
STORAGE_PROVIDER="local" # local | s3 | gcs
STORAGE_LOCAL_ROOT=".storage"
STORAGE_PUBLIC_BASE_URL="/api/v1/storage/files"
STORAGE_SIGNING_SECRET="replace-with-a-distinct-32-char-storage-hmac-secret"
S3_BUCKET="ngo-vault"
S3_REGION="ap-south-1"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

# ------------------------------------------
# EMAIL & NOTIFICATIONS
# ------------------------------------------
EMAIL_PROVIDER="smtp" # smtp | resend | sendgrid
EMAIL_FROM="noreply@ngo-platform.org"
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

# ------------------------------------------
# PAYMENT GATEWAYS (80G Donations — Use TEST keys for QA/Staging!)
# ------------------------------------------
PAYMENT_GATEWAY_DEFAULT="razorpay"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ------------------------------------------
# OPTIONAL GOOGLE WORKSPACE / FIREBASE INTEGRATION (Client Public Config)
# ------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# ------------------------------------------
# ANALYTICS & TELEMETRY
# ------------------------------------------
ANALYTICS_ENABLED="false"
